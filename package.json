{
  "name": "ecommerce-multi-store",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-store ecommerce platform with Turborepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript-eslint": "^8.63.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "^2.1.5",
      "fast-xml-parser": "^5.10.1",
      "flatted": "^3.4.2",
      "ip-address": "^10.7.1",
      "postcss": "^8.5.25",
      "sharp": "^0.35.4",
      "uuid": "^11.1.1",
      "nanoid@3": "^3.3.18",
      "postcss-selector-parser@6": "^6.1.3",
      "browserslist": "^4.28.7",
      "qs": "^6.16.0",
      "@grpc/grpc-js": "^1.13.6",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2"
    }
  }
}
