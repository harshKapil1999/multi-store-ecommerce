NEXT_PUBLIC_API_URL=https://shopbackend.crabtile.com/api/v1
NEXT_PUBLIC_FRONTEND_URL=https://shop.crabtile.com
SESSION_SECRET=replace-with-a-long-random-secret

# Firebase Web SDK configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK configuration for verifying ID tokens in Next.js API routes.
# Use either these service account values or Google Application Default Credentials.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional but recommended for production: comma-separated admin emails.
FIREBASE_ADMIN_EMAILS=admin@example.com
