# Environment
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudflare R2 (S3 Compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-r2-url.com

# CORS Configuration
ADMIN_URL=https://shopadmin.crabtile.com
FRONTEND_URL=https://shop.crabtile.com
PUBLIC_STOREFRONT_URL=https://shop.crabtile.com
ALLOWED_ORIGINS=https://shop.crabtile.com,https://shopadmin.crabtile.com,http://localhost:3000,http://localhost:3001

# SMTP Configuration (for OTP and emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-primary-mailbox@crabtile.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=shop@crabtile.com
MAIL_FROM_NAME=Crabtile Shop
MAIL_FROM_AUTH=noreply@crabtile.com
MAIL_FROM_ORDERS=orders@crabtile.com
MAIL_REPLY_TO_ORDERS=orders@crabtile.com
MAIL_REPLY_TO_SUPPORT=support@crabtile.com
# Optional override. PUBLIC_STOREFRONT_URL automatically creates a store-aware tracking URL.
# FRONTEND_ORDER_TRACKING_URL=https://shop.crabtile.com/store-slug/order-success?orderId={orderId}&email={email}

# Razorpay (for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
